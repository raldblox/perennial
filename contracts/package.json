{
  "name": "perennial-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Perennial vault contracts for the QoreChain EVM, with a helper that opens the EVM authorisation window.",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:dry-run": "forge script script/Deploy.s.sol:Deploy --rpc-url qorechain_testnet --skip-simulation",
    "deploy:testnet": "forge script script/Deploy.s.sol:Deploy --rpc-url qorechain_testnet --broadcast --slow --skip-simulation",
    "e2e": "tsx --env-file=.env scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "swap": "tsx --env-file=.env scripts/swap.ts",
    "cbom": "qorescan solidity src --out ../docs/cbom/contracts.cbom.json",
    "link-agent": "tsx scripts/link-agent.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/pqc": "^0.2.3",
    "@qorechain/sdk": "^0.14.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@qorechain/qorescan": "0.1.0",
    "@types/node": "^22.7.5",
    "create-qorechain-dapp": "^0.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
