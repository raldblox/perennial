# Every value is optional: without them the app points at the QoreChain
# testnet deployment. Nothing here is secret; the build is a static site and
# these values are compiled into it.

# EVM side
VITE_CHAIN_ID=9800
VITE_NETWORK_NAME=QoreChain testnet
VITE_EVM_RPC_URL=https://evm-testnet.qore.host
VITE_EXPLORER_URL=https://explore.qore.network

# The deployed contracts: the vault simulated at the Aave v3 USDC rate, the no-yield vault (its
# source pays nothing) and the demo vault (accelerated testnet rate, simulated,
# not a return). See docs/deployments.md.
VITE_VAULT_ADDRESS=0x78075C631D41AF72c69e34120d5C33cDC7A66A71
VITE_VAULT_DEPLOY_BLOCK=10203526
VITE_NOYIELD_VAULT_ADDRESS=0x76DAC5461fF361f911e5F39810c9455a6180C180
VITE_NOYIELD_VAULT_DEPLOY_BLOCK=10202926
VITE_DEMO_VAULT_ADDRESS=0x496AAa4D585B97c8a26095D97Af4bBfAd473798c
VITE_DEMO_VAULT_DEPLOY_BLOCK=10203015
VITE_ASSET_ADDRESS=0x97143B771D34ddb9130b807b135Ae675A5a963CA

# The native AMM pool that trades fUSD against QOR, for the in-page swap.
VITE_SWAP_POOL_ID=2

# Native side, used only to read and open the EVM window. These endpoints
# refuse cross-origin requests, so by default the app calls paths on its own
# origin that the dev and preview servers forward (see vite.config.ts). A
# production host must forward them too, or set these to a proxy you run.
VITE_NATIVE_CHAIN_ID=qorechain-diana
VITE_REST_URL=/qore/rest
VITE_RPC_URL=/qore/rpc

VITE_FAUCET_URL=https://dashboard.qorechain.io/faucet
VITE_SOURCE_URL=https://github.com/raldblox/perennial

# QoreX handle registry, for @handles as beneficiary and heirs. QoreX and the
# dashboard have both values built in; they are not published. Leave empty to
# accept 0x addresses only.
VITE_HANDLES_URL=
VITE_HANDLES_PUBKEY=
